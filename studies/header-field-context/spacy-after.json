{
  "scope": "Actual spaCy installation/loading/tokenization/entity ruler and SDK mock transports; synthetic rule, no NER accuracy or provider/model calls.",
  "spacy": "3.8.16",
  "patterns": [
    {
      "label": "ORG",
      "pattern": "Authorization:"
    }
  ],
  "direct": {
    "source": "Bearer abc",
    "masked": "Bearer ⟨SECRET_1⟩",
    "restored": "Bearer abc",
    "vault": {
      "version": 1,
      "mappings": [
        {
          "type": "SECRET",
          "original": "abc",
          "surrogate": "⟨SECRET_1⟩",
          "detector": "secret:http_authorization"
        }
      ]
    }
  },
  "sdk": [
    {
      "api": "chat",
      "async": false,
      "stream": false,
      "request": {
        "messages": [
          {
            "role": "assistant",
            "tool_calls": [
              {
                "type": "function",
                "id": "call_1",
                "function": {
                  "name": "request",
                  "arguments": "{\"Authorization\":\"Bearer ⟨SECRET_1⟩\"}"
                }
              }
            ]
          },
          {
            "role": "tool",
            "tool_call_id": "call_1",
            "content": "Done"
          }
        ],
        "model": "test-model"
      },
      "outgoingArguments": "{\"Authorization\":\"Bearer ⟨SECRET_1⟩\"}",
      "correct": true,
      "unrelatedSyntaxPreserved": true,
      "restoresExactly": true,
      "reply": "{\"Authorization\":\"Bearer abc\"}",
      "callerInputUnchanged": true
    },
    {
      "api": "responses",
      "async": false,
      "stream": false,
      "request": {
        "input": [
          {
            "type": "function_call",
            "call_id": "call_1",
            "name": "request",
            "arguments": "{\"Authorization\":\"Bearer ⟨SECRET_1⟩\"}"
          },
          {
            "type": "function_call_output",
            "call_id": "call_1",
            "output": "Done"
          }
        ],
        "model": "test-model"
      },
      "outgoingArguments": "{\"Authorization\":\"Bearer ⟨SECRET_1⟩\"}",
      "correct": true,
      "unrelatedSyntaxPreserved": true,
      "restoresExactly": true,
      "reply": "{\"Authorization\":\"Bearer abc\"}",
      "callerInputUnchanged": true
    },
    {
      "api": "anthropic",
      "async": false,
      "stream": false,
      "request": {
        "max_tokens": 64,
        "messages": [
          {
            "role": "user",
            "content": "Review request."
          },
          {
            "role": "assistant",
            "content": [
              {
                "type": "tool_use",
                "id": "call_1",
                "name": "request",
                "input": {
                  "Authorization": "Bearer ⟨SECRET_1⟩"
                }
              }
            ]
          },
          {
            "role": "user",
            "content": [
              {
                "type": "tool_result",
                "tool_use_id": "call_1",
                "content": "Done"
              }
            ]
          }
        ],
        "model": "test-model"
      },
      "outgoingArguments": "{\"Authorization\": \"Bearer ⟨SECRET_1⟩\"}",
      "correct": true,
      "unrelatedSyntaxPreserved": true,
      "restoresExactly": true,
      "reply": "{\"Authorization\": \"Bearer abc\"}",
      "callerInputUnchanged": true
    }
  ],
  "all_correct": true
}
