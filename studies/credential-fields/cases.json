    },
    {
      "id": "configparser",
      "source": "[credentials]\npassword = local-pass\nclient_secret = another-secret\n\n",
      "value": [
        "local-pass",
        "another-secret"
      ],
      "expected": "[credentials]\npassword = ⟨SECRET_1⟩\nclient_secret = ⟨SECRET_2⟩\n\n",
      "producer": "stdlib ConfigParser.write"
