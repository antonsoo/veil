    },
    {
      "id": "env-reference",
      "source": "PASSWORD=${DATABASE_PASSWORD}\n",
      "value": null,
      "expected": "PASSWORD=${DATABASE_PASSWORD}\n",
      "producer": "constructed spelling"
    },
    {
      "id": "key-only",
      "source": "{\"required\":[\"password\",\"api_key\"]}\n",
      "value": null,
